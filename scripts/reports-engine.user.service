[Unit]
Description=Reports engine (headless JSON API behind api_for_apps)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@ROOT_DIR@
EnvironmentFile=@ROOT_DIR@/.env
ExecStart=@ROOT_DIR@/engine/target/release/reports serve --host 127.0.0.1 --port 8109
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
