# Reports engine settings. Copy to .env (mode 0600) and fill in the secrets.
# Never commit .env. Non-secret defaults live in engine/src/core/config.rs.
APP_ENV=production
SERVER_HOST=127.0.0.1
SERVER_PORT=8109

# PostgreSQL asodya_reports (definitions, roles). Migrate with scripts/migrate.sh --yes.
DATABASE_URL=postgres://reports_user:replace-me@192.168.1.107:5432/asodya_reports

# CouchDB reports_documents (received records)
COUCHDB_URL=http://192.168.1.107:5984
COUCHDB_DATABASE=reports_documents
COUCHDB_USER=
COUCHDB_PASSWORD=

# Redis (cache only)
REDIS_URL=redis://192.168.1.107:6379/6
REDIS_NAMESPACE=reports:

# Key of local operator tools (header x-reports-service-key). Required in production.
REPORTS_SERVICE_API_KEY=
# Optional named keys, JSON object: {"fixtures": "...", "cortex-producer": "..."}
REPORTS_API_KEYS=
